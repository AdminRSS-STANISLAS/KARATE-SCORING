<Application x:Class="FkcScoring.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FkcScoring.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Palette FKC : noir / rouge / blanc, reprise du logo du club -->
        <SolidColorBrush x:Key="BrushFond" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="BrushFondPanneau" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="BrushFondPanneauClair" Color="#242424"/>
        <SolidColorBrush x:Key="BrushRouge" Color="#E4002B"/>
        <SolidColorBrush x:Key="BrushRougeFonce" Color="#8C0019"/>
        <SolidColorBrush x:Key="BrushBleu" Color="#1565C0"/>
        <SolidColorBrush x:Key="BrushBleuFonce" Color="#0B3D75"/>
        <SolidColorBrush x:Key="BrushTexte" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushTexteSecondaire" Color="#B5B5B5"/>
        <SolidColorBrush x:Key="BrushOr" Color="#D4AF37"/>

        <!-- Chrome global -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BrushFond}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexte}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource BrushFond}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexte}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTexte}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushFondPanneauClair}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexte}"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushTexte}"/>
        </Style>
        <!-- Fond clair volontaire pour ComboBox/DatePicker : le texte de ces contrôles reste noir par
             défaut dans le thème WPF standard, un fond sombre le rendrait illisible. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#ECECEC"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#ECECEC"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BrushFondPanneau}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexte}"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>
        <Style TargetType="ItemsControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Navigation -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushRougeFonce}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushRouge}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonPrincipal" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource BrushRouge}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="TitreEcran" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexte}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Style commun à tous les champs de saisie (TextBox/ComboBox/DatePicker) : explicitement
             appliqué partout, il remplace donc les styles implicites par type ci-dessus — fond clair
             volontaire pour garder le texte noir par défaut lisible sans retemplating. -->
        <Style x:Key="Champ" TargetType="Control">
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#ECECEC"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>

        <Style x:Key="Etiquette" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTexteSecondaire}"/>
        </Style>

        <Style x:Key="BoutonAction" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource BrushRouge}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushRougeFonce}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BoutonPoint" TargetType="Button">
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bande "ceinture" décorative (liseré noir/blanc/rouge) -->
        <Style x:Key="BandeCeinture" TargetType="Grid">
            <Setter Property="Height" Value="6"/>
        </Style>
    </Application.Resources>
</Application>
