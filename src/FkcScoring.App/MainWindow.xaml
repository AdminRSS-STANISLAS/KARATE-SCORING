<Window x:Class="FkcScoring.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FKC Scoring" Height="850" Width="1300" MinWidth="1150" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="#101010" LastChildFill="False">
            <Rectangle DockPanel.Dock="Top" Height="4" Fill="#E4002B"/>
            <Image DockPanel.Dock="Top" Source="/Assets/app_logo.jpg" Stretch="Uniform" Height="150" Margin="10,14,10,0"/>
            <TextBlock DockPanel.Dock="Top" x:Name="TxtCompetitionCourante" Text="Aucune compétition" Foreground="#AAAAAA" FontSize="12" Margin="16,12,16,20" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button DockPanel.Dock="Top" x:Name="BtnCompetition" Content="1. Compétition" Click="NavCompetition_Click" Style="{StaticResource NavButton}"/>
            <Button DockPanel.Dock="Top" x:Name="BtnParticipants" Content="2. Participants" Click="NavParticipants_Click" Style="{StaticResource NavButton}"/>
            <Button DockPanel.Dock="Top" x:Name="BtnTableau" Content="3. Tableau" Click="NavTableau_Click" Style="{StaticResource NavButton}"/>
            <Button DockPanel.Dock="Top" x:Name="BtnArbitrage" Content="4. Arbitrage Kumite" Click="NavArbitrage_Click" Style="{StaticResource NavButton}"/>
            <Button DockPanel.Dock="Top" x:Name="BtnExport" Content="5. Export" Click="NavExport_Click" Style="{StaticResource NavButton}"/>

            <!-- Logo partenaire, ancré en bas de la barre latérale -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" BorderBrush="#E4002B" BorderThickness="2" ClipToBounds="True" HorizontalAlignment="Center">
                    <Image Source="/Assets/fkc_logo.jpg" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="FKC PREMIER PARTENAIRE" Foreground="#E4002B" FontSize="11" FontWeight="Bold" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="24"/>

        <TextBlock Grid.Column="1" Text="POWERED BY MANI ONANA STANISLAS LOIC" FontSize="10" Foreground="#555555"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,6"/>
    </Grid>
</Window>
