<Window x:Class="FkcScoring.App.Views.DisplayPublicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FKC Scoring — Diffusion publique"
        Background="#0B0B0B" WindowStyle="None" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Grid Background="#0B0B0B">
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <Grid.RowDefinitions>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="14"/>
                </Grid.RowDefinitions>

                <!-- Bande "ceinture" haute -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="#E4002B"/>
                    <Rectangle Grid.Column="1" Fill="White"/>
                    <Rectangle Grid.Column="2" Fill="#E4002B"/>
                </Grid>

                <!-- En-tête : logo du logiciel + catégorie en cours -->
                <Grid Grid.Row="1" Background="#141414">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Assets/app_logo.jpg" Stretch="Uniform" Height="140" Margin="24,5,30,5"/>
                    <TextBlock x:Name="TxtCategorie" Grid.Column="1" Text="—" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" TextAlignment="Right"/>
                </Grid>

                <!-- Corps : les deux compétiteurs -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#3A0009">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AKA" FontSize="38" FontWeight="Bold" Foreground="White" Opacity="0.65" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtNomAka" Text="—" FontSize="54" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="820"/>
                            <TextBlock x:Name="TxtClubAka" Text="" FontSize="26" Foreground="#DDDDDD" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtScoreAka" Text="0" FontSize="220" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="EchelleScoreAka" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Column="1" Fill="White"/>

                    <Grid Grid.Column="2" Background="#03264F">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="AO" FontSize="38" FontWeight="Bold" Foreground="White" Opacity="0.65" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtNomAo" Text="—" FontSize="54" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="820"/>
                            <TextBlock x:Name="TxtClubAo" Text="" FontSize="26" Foreground="#DDDDDD" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtScoreAo" Text="0" FontSize="220" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="EchelleScoreAo" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Chronomètre -->
                <Border Grid.Row="3" Background="Black" BorderBrush="#E4002B" BorderThickness="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtEtat" Grid.Column="0" Text="" FontSize="30" FontWeight="Bold" Foreground="#D4AF37" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"/>
                        <TextBlock x:Name="TxtChrono" Grid.Column="1" Text="00:00" FontSize="110" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="86" Height="86" CornerRadius="43" BorderBrush="#E4002B" BorderThickness="2" ClipToBounds="True" HorizontalAlignment="Center">
                                <Image Source="/Assets/fkc_logo.jpg" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="FKC PREMIER PARTENAIRE" FontSize="15" FontWeight="Bold" Foreground="#E4002B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="POWERED BY MANI ONANA STANISLAS LOIC" FontSize="14" Foreground="#4A4A4A"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,8"/>
                    </Grid>
                </Border>

                <!-- Bande "ceinture" basse -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="#E4002B"/>
                    <Rectangle Grid.Column="1" Fill="White"/>
                    <Rectangle Grid.Column="2" Fill="#E4002B"/>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
