<UserControl x:Class="FkcScoring.App.Views.TableauView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="TxtAvertissement" Text="Créez d'abord une compétition et une catégorie Kumite avec au moins 2 inscrits." FontSize="16" Foreground="#888" Visibility="Collapsed"/>

        <DockPanel x:Name="PanelContenu">
            <StackPanel DockPanel.Dock="Top" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="Tableau" Style="{StaticResource TitreEcran}"/>

                <TextBlock Text="Catégorie (Kumite individuel)" Style="{StaticResource Etiquette}"/>
                <ComboBox x:Name="CmbCategorie" Style="{StaticResource Champ}" SelectionChanged="CmbCategorie_SelectionChanged"/>

                <TextBlock x:Name="TxtInfoTableau" FontSize="13" Foreground="#666" Margin="0,4,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnGenerer" Content="Générer le tableau" Style="{StaticResource BoutonAction}" Click="Generer_Click"/>
                    <Button x:Name="BtnPhaseFinale" Content="Terminer les poules → générer la phase finale" Style="{StaticResource BoutonAction}" Margin="12,0,0,0" Visibility="Collapsed" Click="GenererPhaseFinale_Click"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstCombats" Margin="0,16,0,0" MaxWidth="900" HorizontalAlignment="Left"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
